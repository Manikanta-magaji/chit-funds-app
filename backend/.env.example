# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Google OAuth 2.0 credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# SQLite path (relative to backend directory)
DATABASE_URL=sqlite:///./chit_fund.db

# Frontend URL (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
